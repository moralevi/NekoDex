<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <!-- Manifest fields consumed by DalamudPackager -->
    <Author>moralevi</Author>
    <Name>NekoDex</Name>
    <Punchline>Track what your character owns and how to get what is missing.</Punchline>
    <Description>Collection tracker for the logged-in character: mounts, minions, orchestrion and Armoire with in-game unlock info, an outfit planner, a gear advisor and a daily/weekly checklist.
Information and UI only. No automation.</Description>
    <RepoUrl>https://github.com/moralevi/NekoDex</RepoUrl>
    <Tags>collection;mounts;tracker;minions;glamour;checklist</Tags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NekoDex.Core\NekoDex.Core.csproj" />
    <!-- Shipped by Dalamud; used for localisable strings. -->
    <Reference Include="CheapLoc" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by tools/DataGen; embedded so unlock info works offline. -->
    <EmbeddedResource Include="Data\unlocks.json" LogicalName="NekoDex.Data.unlocks.json" />
    <!-- Shown in /xlplugins; Dalamud looks for images/icon.png next to the dll. -->
    <Content Include="..\..\images\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Translations (CheapLoc format). en.json is generated by tools/LocExport and is the reference for translators. -->
    <Content Include="..\..\loc\*.json" Link="loc\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    Debug builds are copied to Dalamud's devPlugins folder so the plugin shows up under
    /xlplugins -> Dev Tools -> Installed Dev Plugins. Dalamud loads dev plugins into memory,
    so rebuilding while the game runs is fine; reload from that list afterwards.
    Override with -p:DevPluginsDir=... or disable with -p:CopyToDevPlugins=false.
  -->
  <PropertyGroup>
    <CopyToDevPlugins Condition="'$(CopyToDevPlugins)' == ''">true</CopyToDevPlugins>
    <DevPluginsDir Condition="'$(DevPluginsDir)' == ''">$(APPDATA)\XIVLauncher\devPlugins\$(AssemblyName)\</DevPluginsDir>
  </PropertyGroup>
  <Target Name="CopyToDevPlugins" AfterTargets="Build" Condition="'$(CopyToDevPlugins)' == 'true' AND '$(Configuration)' == 'Debug' AND '$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <DevPluginFiles Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DevPluginFiles)" DestinationFiles="@(DevPluginFiles->'$(DevPluginsDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="NekoDex: copied dev build to $(DevPluginsDir)" />
  </Target>
</Project>
