<Project Sdk="Microsoft.NET.Sdk">
  <!-- Regenerates loc/en.json from every Strings.Get call in the plugin source. Run from the repo root with: dotnet run (project tools/LocExport) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NekoDex.LocExport</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NekoDex.Core\NekoDex.Core.csproj" />
  </ItemGroup>
</Project>
